# The build context is the repo root (the images install the package from
# source), but only pyproject.toml, src/ and pipelines/ are copied. Everything
# else is transfer cost — data/ alone is 100MB of collection snapshots.
.git
.venv
data
build
dist
docs
infra
android
*.egg-info
__pycache__
.pytest_cache
.env
.env.*
!.env.example
