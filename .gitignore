# Python
__pycache__/
*.egg-info/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env
# Local env variants (backups, per-machine overrides) must never be committed,
# but the checked-in template must stay tracked.
.env.*
!.env.example
setup.py

# Data (runtime generated)
/data/
anki_vector_store/
anki_matrix.pkl
anki_notes.pkl
anki_vectorizer.pkl
anki_analytics.db
data.txt
prompt_anki.txt

# Streamlit (legacy)
.streamlit/secrets.toml

# Web frontend
web/node_modules/
web/dist/

# IDE
.vscode/
.idea/
.DS_Store
*.apkg
# Machine-local Claude Code files. The skills and agents are shared.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/hooks/

# Android build output
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
# Built APKs copied out for sideloading; never committed.
*.apk

# Python build output
/build/
/dist/

# Snapshot staging file. Windows will not let us delete it while the
# abandoned backup thread still holds its handle, so it lingers at 0 bytes.
*.backup-tmp
