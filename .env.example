# ==========================================================
# Pipeline
# ==========================================================
# Your Anki collection. Auto-detected when Anki desktop has exactly one
# profile; set it explicitly otherwise. Only ever read via a snapshot.
#   Windows: C:/Users/<you>/AppData/Roaming/Anki2/<Profile>/collection.anki2
#   macOS:   ~/Library/Application Support/Anki2/<Profile>/collection.anki2
# ANKI_COLLECTION_PATH=

# Which pipeline in pipelines/ to run (its profile.yaml, and its own folder under
# DATA_DIR/pipelines/). Empty: pipelines/data-platform/profile.yaml, with the
# warehouse in DATA_DIR itself as before.
# ANKIGEN_PIPELINE=
# A profile to use instead of the pipeline's own.
# ANKIGEN_PROFILE=

# Warehouse, snapshots and outputs. Default: ./data
# DATA_DIR=


# ==========================================================
# LLM provider
# ==========================================================
# Presets: ollama | groq | nvidia | openrouter | sambanova | mistral | gemini
#
# Anything except "gemini" speaks the OpenAI protocol, so LLM_BASE_URL and
# LLM_MODEL below can point at any other compatible endpoint too.
#
# Free-tier limits and model names change often. Check the provider's docs,
# and see https://github.com/mnfst/awesome-free-llm-apis for a maintained list.

# RECOMMENDED: groq for generation, local Ollama for embeddings.
# Free, no card, and a far better model than phi4-mini. Two steps:
#   1. Grab a key at https://console.groq.com/keys
#   2. Set LLM_PROVIDER=groq and paste it into LLM_API_KEY below
# Then run:  python cli.py providers
LLM_PROVIDER=ollama

# Required for every hosted provider (not for local Ollama).
LLM_API_KEY=

# Optional — override the preset's endpoint and model.
# LLM_BASE_URL=
# LLM_MODEL=


# ==========================================================
# AnkiWeb (optional: push cards straight into your collection)
# ==========================================================
# Without this you import data/out/<date>/ankigen_<date>.apkg by hand. With
# it, `ankigen push` syncs the day's cards to AnkiWeb and your devices pull
# them down like any other change. Needs the extra: pip install ".[push]"
#
# Log in once and store the key instead of your password:
#   ankigen push --login
#
# ANKIWEB_USERNAME=
# ANKIWEB_PASSWORD=
# ANKIWEB_KEY=
# ANKIWEB_ENDPOINT=        # only for a self-hosted sync server


# ==========================================================
# Card checker (verify stage)
# ==========================================================
# Empty means the model that wrote the card also checks it, which works but
# is the weaker arrangement: it shares its own blind spots. Pointing this at
# a different model catches more, and since free tiers meter per model, it
# also costs nothing. A good pairing is a high-volume provider for writing
# and a different one for checking.
# VERIFY_PROVIDER=
# VERIFY_MODEL=


# ==========================================================
# Embeddings (semantic dedup)
# ==========================================================
# Configured separately because most free chat APIs serve no embedding
# endpoint. Leave EMBEDDING_PROVIDER empty and it derives automatically:
# the chat provider if it supports embeddings, otherwise `fastembed`.
#
# fastembed runs an ONNX model in this process — no server, no key, no quota,
# nothing to leave running. It downloads ~50MB once, then embeds roughly a
# thousand cards a second, and it is the only option that works unchanged on
# a CI runner. Set EMBEDDING_PROVIDER=ollama to use a local Ollama instead.
#
# With no embeddings available, dedup still works but drops to fuzzy text
# matching only — near-identical wording is caught, rephrasings are not.

# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL_NAME=


# ==========================================================
# Provider notes
# ==========================================================
#
# ollama      Local, free, unlimited, offline. Serves embeddings.
#             Install https://ollama.com then:
#               ollama pull phi4-mini && ollama pull nomic-embed-text
#
# groq        Fastest, and 1000 requests/day. openai/gpt-oss-120b.
#             Key: https://console.groq.com/keys
#             No embeddings - falls back to local Ollama automatically.
#
# nvidia      The only preset here serving both chat and embeddings.
#             Key: https://build.nvidia.com (free developer account)
#
# openrouter  RECOMMENDED if you want ONE provider: free chat AND free
#             embeddings on a single key, so no local Ollama is needed.
#             ~50 requests/day (1000 after $10 of credit ever purchased).
#             Key: https://openrouter.ai/keys
#
# sambanova   Daily token budget rather than a request cap.
#             Key: https://cloud.sambanova.ai
#
# mistral     Free tier is monthly credits. Serves embeddings.
#             Key: https://console.mistral.ai
#
# Model settings take a preference order, best first:
#   GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
# A run works down it, moving on when a model is out of quota for the day or
# is answering 503. That is how seven decks get cards out of a twenty-request
# allowance, and how the newest model can be preferred without the run dying
# when it is busy.
#
# gemini      Uses the google-genai SDK, not the OpenAI protocol.
#             Key: https://aistudio.google.com/apikey  (no card needed)
#             Measured Sept 2026, and much tighter than the blog posts say:
#               - chat:       20 requests/day, PER MODEL
#               - embeddings: 100/minute, counted per text, not per batch
#             One pipeline run needs ~14 chat calls, so a single model covers
#             one run a day and nothing else. The per-model quota is the way
#             out: generate on one model, VERIFY_MODEL on another. Popular
#             models also return 503 "high demand" for long stretches; when
#             that happens an older flash usually answers immediately.


# ==========================================================
# Ollama (used when LLM_PROVIDER=ollama, and as the embedding fallback)
# ==========================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi4-mini
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==========================================================
# Claude (used when LLM_PROVIDER=claude), through the Claude Code CLI on a
# Claude subscription: a local `claude` login, or CLAUDE_CODE_OAUTH_TOKEN from
# `claude setup-token`. API keys are removed from the CLI's environment.
# ==========================================================
# CLAUDE_MODEL=claude-opus-5-5,claude-sonnet-5
# VERIFY_PROVIDER=claude
# VERIFY_MODEL=claude-sonnet-5
# Where requests go when Claude cannot answer (usage limit, no login):
# FALLBACK_PROVIDER=gemini
# FALLBACK_VERIFY_MODEL=gemini-3.5-flash-lite


# ==========================================================
# Gemini (used when LLM_PROVIDER=gemini)
# ==========================================================
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
