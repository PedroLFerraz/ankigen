{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_llm_calls_per_run": {
          "default": 0,
          "description": "0: no cap.",
          "minimum": 0,
          "title": "Max Llm Calls Per Run",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Models": {
      "additionalProperties": false,
      "description": "Who writes and who checks. The defaults are what the daily run has used:\nClaude on the subscription, with Gemini's free tier behind it.",
      "properties": {
        "writer": {
          "default": "claude",
          "title": "Writer",
          "type": "string"
        },
        "writer_models": {
          "default": [
            "claude-opus-5-5",
            "claude-sonnet-5"
          ],
          "items": {
            "type": "string"
          },
          "title": "Writer Models",
          "type": "array"
        },
        "checker": {
          "default": "claude",
          "title": "Checker",
          "type": "string"
        },
        "checker_models": {
          "default": [
            "claude-sonnet-5"
          ],
          "items": {
            "type": "string"
          },
          "title": "Checker Models",
          "type": "array"
        },
        "fallback": {
          "default": "gemini",
          "description": "Takes over when the writer's provider cannot answer at all. Empty: none.",
          "title": "Fallback",
          "type": "string"
        },
        "fallback_models": {
          "default": [
            "gemini-3.8-flash",
            "gemini-3.7-flash",
            "gemini-3.6-flash",
            "gemini-3.5-flash"
          ],
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "fallback_checker_models": {
          "default": [
            "gemini-3.5-flash-lite",
            "gemini-flash-lite-latest",
            "gemini-3.1-flash-lite"
          ],
          "items": {
            "type": "string"
          },
          "title": "Fallback Checker Models",
          "type": "array"
        }
      },
      "title": "Models",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "properties": {
        "guide_pdf": {
          "default": true,
          "description": "Write the day's study guide as a PDF.",
          "title": "Guide Pdf",
          "type": "boolean"
        },
        "push_to_ankiweb": {
          "default": true,
          "description": "Put the cards into Anki over AnkiWeb. Off, they are only in the .apkg.",
          "title": "Push To Ankiweb",
          "type": "boolean"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "description": "Five fields, minute hour day month weekday, read in `timezone`. Each run writes the next curriculum day.",
          "title": "Cron",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "description": "An IANA time zone, e.g. America/Sao_Paulo.",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "cron"
      ],
      "title": "Schedule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "schedule": {
      "$ref": "#/$defs/Schedule"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    },
    "models": {
      "$ref": "#/$defs/Models"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    }
  },
  "required": [
    "name",
    "schedule"
  ],
  "title": "AnkiGen pipeline",
  "type": "object"
}
